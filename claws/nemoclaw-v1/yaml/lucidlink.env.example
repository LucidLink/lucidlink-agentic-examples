# Settings for prepare.sh. No secrets here: tokens live in the credential directories
# (host/install-host.sh mcp-token), the model API keys in the environment of `nemoclaw apply`.

# Deployment identity. Keep it stable: it names the OpenShell workspace (nc-<sha256(uid)[:16]>) that the
# volumes are labelled for. prepare.sh writes a fresh one here on first run if it's empty.
NEMOCLAW_UID=
DEPLOYMENT_NAME=lucidlink-agents

# Managed gateway (pick a free port and network if another deployment runs on this host).
GATEWAY_PORT=17671
GATEWAY_CIDR=172.29.0.0/24

# Filespace: lucid status shows the id and the object store.
FILESPACE_NAME=my-filespace
FILESPACE_ID=00000000-0000-0000-0000-000000000000
STORAGE_HOST=s3.us-west-1.amazonaws.com
# BUCKET=lucid-fs-<FILESPACE_ID>   (default)

# One service account per agent (host/install-host.sh mcp-token <agent>), so the audit trail names the agent.
# Its grants are the boundary: the researcher's is read-only, the coder's covers its own folder.
RESEARCHER_CRED_DIR=/etc/lucid-agent/mcp-researcher
CODER_CRED_DIR=/etc/lucid-agent/mcp-coder

# LucidLink folders mounted on the host by lucid-agent@ units (running as uid 10001).
SKILLS_DIR=/srv/lucid-ro-skills          # shared, mounted with a read-only service account
CODER_DIR=/srv/lucid-agent-coder         # the coder's own folder, mounted with the coder's service account

# NemoClaw harness images, pinned by digest.
OPENCLAW_IMAGE=nc-fabric@sha256:<openclaw digest>
CLAUDE_IMAGE=nc-fabric@sha256:<claude digest>

# Models. The researcher (OpenClaw) uses NVIDIA's API (NVIDIA_API_KEY) or Anthropic (ANTHROPIC_API_KEY).
# The coder (Claude Code) needs an Anthropic Messages endpoint, so it always uses Anthropic.
RESEARCHER_PROVIDER=nvidia
RESEARCHER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CODER_MODEL=claude-sonnet-4-6

# Toolchain (see ../toolchain/Dockerfile).
LUCIDLINK_MCP_VERSION=1.0.1
# INTERPRETER=/opt/lucidlink/python/cpython-3.12.16-linux-x86_64-gnu/bin/python3.12   (default)
